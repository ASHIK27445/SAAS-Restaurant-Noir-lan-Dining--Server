// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id  String  @id @default(cuid())
  email       String   @unique
  firebaseUid String   @unique

  name        String?
  phone       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum CategoryBucket {
  MEALS
  DRINKS
  DESSERTS
  SIDES
}

model Category {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  image       String?
  isActive    Boolean        @default(true)
  sortOrder   Int            @default(0)
  bucketType  CategoryBucket @default(MEALS) // NEW — which of the 4 POS buckets this falls under
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  menuItems MenuItem[]

  @@index([bucketType])
}

model MenuItem {
  id  String  @id   @default(cuid())
  name  String @unique
  description String

  price Decimal @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)

  sku String  @unique
  image String?

  calories Int?

  isActive Boolean @default(true)

  isVegan             Boolean             @default(false)
  isVegetarian        Boolean             @default(false)
  isGlutenFree        Boolean             @default(false)

  kitchenNotes        String?             @db.Text

  preparationTime     Int?
  spiceLevel          Int?
  stockQuantity       Int?

  dietaryType     DietaryType[]
  allergens       MenuItemAllergen[]
  orderItems      OrderItem[]

  categoryId String 
  category Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt
}

model Allergen {
  id          String      @id @default(cuid())

  name        String      @unique

  createdAt   DateTime    @default(now())

  menuItems   MenuItemAllergen[]
}

model MenuItemAllergen {
  menuItemId   String
  allergenId   String

  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id])
  allergen     Allergen   @relation(fields: [allergenId], references: [id])

  @@id([menuItemId, allergenId])
}

enum DietaryType {
  VEGAN
  VEGETARIAN
  GLUTEN_FREE
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PREPARING
  SERVED           // dine-in only
  OUT_FOR_DELIVERY // delivery only
  RECEIVED         // delivery only
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   Int           @unique @default(autoincrement()) // displayed as #00001
  orderType     OrderType
  status        OrderStatus   @default(PREPARING)

  // Payment timing differs by type: takeaway/delivery pay upfront at creation;
  // dine-in pays later, at completion. "status" never implies payment.
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod String?
  paidAt        DateTime?
  cashierName   String?       // snapshot of the active cashier at the moment payment was taken

  serverStaffId String?
  serverName    String?       // snapshot of the Waiter selected at order creation

  // Dine-in only
  tableNo       String?
  guestCount    Int?
  customerName  String?       // dine-in pays later — note who to bill

  // Delivery only
  deliveryAddress String?

  note          String?
  subtotal      Decimal @db.Decimal(10, 2)
  tax           Decimal @db.Decimal(10, 2)
  serviceCharge Decimal @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)

  items OrderItem[]

  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([orderType])
  @@index([createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  note       String?

  units OrderItemUnit[]

  @@index([orderId])
  @@index([menuItemId])
}

// One row per physical unit ordered (qty=2 Chicken Roast -> 2 rows). Order time comes
// from orderItem.order.createdAt — not duplicated here. Wait time = prepCompletedAt -
// order.createdAt. Prep duration = prepCompletedAt - prepStartedAt. Both are useful and
// distinct: wait time includes queue time before the kitchen even started this unit.
model OrderItemUnit {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  unitIndex   Int       // 1, 2, 3... within the OrderItem

  prepStartedAt   DateTime? // set manually by kitchen staff
  prepCompletedAt DateTime? // set manually by kitchen staff

  @@index([orderItemId])
}

// Single mutable pointer to whichever staff member is on cashier duty right now.
// Updated directly when shifts change — no history tracking requested.
model CashierSetting {
  id                   String   @id @default(cuid())
  activeCashierStaffId String?
  activeCashier        Staff?   @relation(fields: [activeCashierStaffId], references: [id])
  updatedAt            DateTime @updatedAt
}

//----------------staff----------------------------
model Staff {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  role          RoleEnum
  title         String
  phone         String
  avatar        String?
  isActive      Boolean   @default(false)
  systemAccess  Boolean   @default(false)
  online        Boolean   @default(false)
  location      String?
  hourlyRate    Decimal?  @db.Decimal(10, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Standing schedule — every staff member (except Admin) works these hours daily.
  // The restaurant runs every day, so there's no day-off concept here.
  scheduleStartTime String?   // "HH:MM"
  scheduleEndTime   String?   // "HH:MM"
  scheduleLabel     String?   // "Morning Shift", "Night Shift", etc.

  rateHistory          RateHistory[]
  openShiftAssignments OpenShiftAssignment[]
  dailyAttendance      DailyAttendance[]
  cashierAssignments   CashierSetting[]

  @@index([email])
  @@index([role])
  @@index([online])
}

enum RoleEnum {
  Chef
  SousChef  
  Waiter
  Cashier
  Manager
  Admin
}

model RateHistory {
  id            String    @id @default(cuid())
  staffId       String
  staff         Staff     @relation(fields: [staffId], references: [id])

  rate          Decimal   @db.Decimal(10, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime? // null = currently in effect

  createdAt DateTime @default(now())

  @@index([staffId])
  @@index([effectiveFrom])
}

// Ad-hoc shifts only — overtime coverage or one-off events. Regular daily work comes
// straight from Staff.scheduleStartTime/scheduleEndTime, so there's no "normal shift"
// model anymore.
model OpenShift {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  startTime String   // "HH:MM" — fixed at creation
  endTime   String   // "HH:MM" — fixed at creation
  label     String   // "Private Event", "Extra Coverage"...
  role      String   // role needed for this shift

  assignments OpenShiftAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model OpenShiftAssignment {
  id               String            @id @default(cuid())
  openShiftId      String
  openShift        OpenShift         @relation(fields: [openShiftId], references: [id], onDelete: Cascade)
  staffId          String
  staff            Staff             @relation(fields: [staffId], references: [id])

  // Snapshot of the rate to pay for this open shift — defaults to staff.hourlyRate at
  // assignment time but can be manually overridden (e.g. event bonus rate).
  rateAtAssignment Decimal           @db.Decimal(10, 2)

  dailyAttendance  DailyAttendance?

  createdAt DateTime @default(now())

  @@unique([openShiftId, staffId])
  @@index([openShiftId])
  @@index([staffId])
}

// The single source of truth for attendance + wages. One row per staff member per day.
// Saved permanently — this IS the historical record used by daily/monthly/yearly reports.

model DailyAttendance {
  id      String   @id @default(cuid())
  staffId String
  staff   Staff    @relation(fields: [staffId], references: [id])
  date    DateTime @db.Date

  // Regular schedule attendance (checkboxes 1 & 2)
  checkIn      DateTime?
  checkOut     DateTime?
  rateUsed     Decimal?  @db.Decimal(10, 2) // snapshot of staff.hourlyRate at checkIn
  regularHours Decimal?  @db.Decimal(5, 2)  // rounded per the >=20min-rounds-up rule
  regularWage  Decimal?  @db.Decimal(10, 2) // regularHours × rateUsed

  // Open shift attendance (checkbox 3) — only relevant if this staff has an
  // OpenShiftAssignment for this date. Hours come from the OpenShift's fixed
  // start/end time, not a separate manual clock.
  openShiftAssignmentId String?              @unique
  openShiftAssignment   OpenShiftAssignment? @relation(fields: [openShiftAssignmentId], references: [id])
  openShiftAttended     Boolean              @default(false)
  openShiftHours        Decimal?             @db.Decimal(5, 2)
  openShiftWage         Decimal?             @db.Decimal(10, 2)

  // Manager-given bonus — can be added same-day or later (e.g. end of month)
  bonus     Decimal  @default(0) @db.Decimal(10, 2)

  totalWage Decimal? @db.Decimal(10, 2) // regularWage + openShiftWage + bonus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, date])
  @@index([staffId])
  @@index([date])
}

// ─────────────────────────────────────────
// Inventory / Supplier / Procurement module
// ─────────────────────────────────────────

model Supplier {
  id          String         @id @default(cuid())
  name        String
  category    String         // e.g. "Produce", "Dairy & Cheese", "Meat & Poultry", "Seafood"
  contactName String?
  email       String?
  phone       String?
  address     String?
  rating      Float?         @default(0)
  status      SupplierStatus @default(ACTIVE)

  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model InventoryItem {
  id           String  @id @default(cuid())
  name         String
  sku          String  @unique
  unit         String
  image        String?
  category     String  // e.g. "Produce", "Dairy & Cheese", "Meat & Poultry" — same vocabulary as Supplier.category

  currentStock Decimal @db.Decimal(10, 2) @default(0)
  minThreshold Decimal @db.Decimal(10, 2) @default(0)
  costPerUnit  Decimal @db.Decimal(10, 2)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([category])
}

enum StockMovementType {
  RESTOCK
  USAGE
  WASTE
  ADJUSTMENT
}

model StockMovement {
  id              String            @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id])

  type     StockMovementType
  quantity Decimal           @db.Decimal(10, 2) // positive for RESTOCK, negative for USAGE/WASTE, +/- for ADJUSTMENT
  note     String?

  createdAt DateTime @default(now())

  @@index([inventoryItemId])
}

enum PurchaseOrderStatus {
  PENDING
  SHIPPED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  poNumber     String              @unique
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  status       PurchaseOrderStatus @default(PENDING)
  issuedDate   DateTime            @default(now())
  expectedDate DateTime?
  deliveredDate DateTime?           // set automatically when status becomes RECEIVED
  purchaseAmount Decimal           @db.Decimal(10, 2) @default(0)
  totalAmount  Decimal             @db.Decimal(10, 2) @default(0)
  rating       Float?

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity        Decimal       @db.Decimal(10, 2)
  unitPrice       Decimal       @db.Decimal(10, 2)
  receivedQuantity  Decimal?    @db.Decimal(10, 2)
  receivedUnitPrice Decimal?    @db.Decimal(10, 2)


  @@index([purchaseOrderId])
  @@index([inventoryItemId])
}


model SupplierContact {
  id            String   @id @default(cuid())

  companyName   String
  category      String?        // e.g. "Produce", "Seafood" — optional tag, not linked to Supplier.category
  contactName   String?
  role          String?        // e.g. "Key Account Manager"
  email         String?
  phone         String?
  address       String?
  businessHours String?        // e.g. "Mon-Fri, 6am - 2pm"
  isFavorite    Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isFavorite])
  @@index([category])
}